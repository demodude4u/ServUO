using System;
using Server;

namespace Server.Items
{
   public class FireBrazier : BaseAddon
   {
      public override BaseAddonDeed Deed{ get{ return new FireBrazierDeed(); } }

      [Constructable]
      public FireBrazier()
      {

         AddComponent( new AddonComponent( 3633 ), 0, 0, 0 );    
         AddComponent( new AddonComponent( 6571 ), 0, 0, 7 );              
           
      }

      public FireBrazier( Serial serial ) : base( serial )
      {
      }

      public override void Serialize( GenericWriter writer )
      {
         base.Serialize( writer );

         writer.Write( (int) 0 ); // version
      }

      public override void Deserialize( GenericReader reader )
      {
         base.Deserialize( reader );

         int version = reader.ReadInt();
      }
   }

   public class FireBrazierDeed : BaseAddonDeed
   {
      public override BaseAddon Addon{ get{ return new FireBrazier(); } }
      
      [Constructable]
      public FireBrazierDeed()
		{
			Name = "A Brazier of Fire Deed";
   
		}

      public FireBrazierDeed( Serial serial ) : base( serial )
      {

      }

      public override void Serialize( GenericWriter writer )
      {
         base.Serialize( writer );

         writer.Write( (int) 0 ); // version
      }

      public override void Deserialize( GenericReader reader )
      {
         base.Deserialize( reader );

         int version = reader.ReadInt();
      }
   }

   
} 